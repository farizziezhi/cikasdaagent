{
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.9.2",
    "migrations": {
      "modelPolicyAllowlist": true
    }
  },
  "models": {
    "providers": {
      "router9": {
        "baseUrl": "http://127.0.0.1:20128/v1",
        "apiKey": "${ROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemini/gemini-3.5-flash-lite",
            "name": "Gemini 3.5 Flash Lite",
            "input": ["text", "image"]
          },
          {
            "id": "gemini/gemini-3.8-flash",
            "name": "Gemini 3.8 Flash",
            "input": ["text", "image"]
          },
          {
            "id": "agnes/agnes-3.0-flash",
            "name": "Agnes 3.0 Flash",
            "input": ["text", "image"]
          },
          { "id": "groq/qwen/qwen3-32b", "name": "Qwen 3 32B" },
          {
            "id": "cf/@cf/moonshotai/kimi-k2.6",
            "name": "Kimi K2.6",
            "input": ["text", "image"]
          },
          {
            "id": "cf/@cf/zai-org/glm-4.7-flash",
            "name": "GLM 4.7 Flash",
            "input": ["text", "image"]
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "router9/gemini/gemini-3.5-flash-lite",
        "fallbacks": [
          "router9/gemini/gemini-3.8-flash",
          "router9/agnes/agnes-3.0-flash",
          "router9/groq/qwen/qwen3-32b",
          "router9/cf/@cf/moonshotai/kimi-k2.6",
          "router9/cf/@cf/zai-org/glm-4.7-flash"
        ]
      },
      "imageModel": "router9/gemini/gemini-3.5-flash-lite",
      "thinkingDefault": "off",
      "skipBootstrap": true,
      "skills": []
    },
    "entries": {
      "main": {
        "name": "PPID Agent (Sistem Arsip & Notulen)",
        "thinkingDefault": "off"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["*"],
      "streaming": {
        "mode": "off"
      }
    }
  },
  "tools": {
    "deny": ["group:media", "group:web", "skill_workshop"]
  },
  "skills": {
    "allowBundled": []
  },
  "plugins": {
    "load": {
      "paths": ["."]
    },
    "allow": ["ppid-agent-tools"],
    "entries": {
      "google": {
        "enabled": true
      },
      "ppid-agent-tools": {
        "enabled": true
      }
    }
  }
}
