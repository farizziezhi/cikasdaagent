# ============================================================
# Environment Variables — AI Agent Arsip & Notulensi PPID
# Salin file ini ke .env dan isi semua value.
# Ref: TDD §2
# ============================================================

# --- Required: Bot & AI API Keys ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Required: Google Service Account (base64-encoded JSON) ---
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Required: Google Drive & Sheets IDs ---
DRIVE_ARCHIVE_FOLDER_ID=
DRIVE_MINUTES_FOLDER_ID=
DRIVE_WATCH_FOLDER_ID=
PPID_DRIVE_FOLDER_ID=
PPID_DRIVE_CLIENT_ID=
PPID_DRIVE_CLIENT_SECRET=
PPID_DRIVE_REFRESH_TOKEN=
PPID_DRIVE_FOLDER_ID=
PPID_DRIVE_CLIENT_ID=
PPID_DRIVE_CLIENT_SECRET=
PPID_DRIVE_REFRESH_TOKEN=
AUDIT_LOG_SHEET_ID=

# --- Required: Whitelist staf (comma-separated chat_id) ---
WHITELIST_CHAT_IDS=

# --- Optional (ada default) ---
# MAX_DIRECT_SEND_MB=50
# GROQ_MAX_UPLOAD_MB=25
# CHUNK_DURATION_MINUTES=20

# --- Integrasi PPID-Digital (Supabase) ---
PPID_SUPABASE_URL=https://your-project.supabase.co
PPID_SUPABASE_SERVICE_KEY=your-service-role-key-or-anon-key

# --- Integrasi SIVERA (Supabase PostgreSQL + Realtime) ---
SIVERA_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
SIVERA_SUPABASE_URL=
SIVERA_SUPABASE_SERVICE_KEY=

# --- Integrasi APEL-IN (Neon PostgreSQL) ---
APELIN_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Gateway Auth Token (Rotated / Keep Secret) ---
OPENCLAW_GATEWAY_TOKEN=

# --- Broadcast Proaktif (Scheduler CIKASDA) ---
# Daftar chat_id penerima broadcast proaktif, dipisah koma (contoh: 123456789,-1001234567890)
BROADCAST_CHAT_IDS=
# Kirim ke seluruh pengguna terdaftar di Sheet tab RegisteredUsers ("true" atau "false", default: true)
BROADCAST_TO_REGISTERED=true

# --- Integrasi WordPress CIKASDA NEWS (opsional — DRAFT only) ---
# Buat user khusus role Editor di WP Admin + Application Password (jangan akun Admin pribadi)
WP_BASE_URL=https://cikasda.sultengprov.go.id
WP_USER=
WP_APP_PASSWORD=
WP_CATEGORY_ID=3,7



