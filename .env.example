# ============================================================
# Environment Variables — AI Agent Arsip & Notulensi PPID
# Salin file ini ke .env dan isi semua value.
# Ref: TDD §2
# ============================================================

# --- Required: Bot & AI API Keys ---
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Required: Google Service Account (base64-encoded JSON) ---
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Required: Google Drive & Sheets IDs ---
DRIVE_ARCHIVE_FOLDER_ID=
DRIVE_MINUTES_FOLDER_ID=
AUDIT_LOG_SHEET_ID=

# --- Required: Whitelist staf (comma-separated chat_id) ---
WHITELIST_CHAT_IDS=

# --- Optional (ada default) ---
# MAX_DIRECT_SEND_MB=50
# GROQ_MAX_UPLOAD_MB=25
# CHUNK_DURATION_MINUTES=20

# --- Integrasi PPID-Digital (Supabase) ---
PPID_SUPABASE_URL=https://your-project.supabase.co
PPID_SUPABASE_SERVICE_KEY=your-service-role-key-or-anon-key

# --- Integrasi SIVERA (Neon PostgreSQL) ---
SIVERA_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# --- Integrasi APEL-IN (Neon PostgreSQL) ---
APELIN_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require


